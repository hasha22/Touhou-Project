  m_Script: {fileID: 11500000, guid: aa52f05b9382e724291722bbd9407972, type: 3}
  m_Name: Cirno Initial Dialogue Sequence
  m_EditorClassIdentifier: Assembly-CSharp::KH.DialogueSequence
  lines:
  - speakerName: Cirno
    speakerType: 1
    text: Hey! Wait up!
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  - speakerName: Reimu Hakurei
    speakerType: 0
    text: Huh??
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  - speakerName: Reimu Hakurei
    speakerType: 0
    text: ... What do you want? Can't you see I'm busy?
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  - speakerName: Cirno
    speakerType: 1
    text: Not busy enough to skip on seeing my new powers!
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  - speakerName: Reimu Hakurei
    speakerType: 0
    text: Ugh...
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  - speakerName: Reimu Hakurei
    speakerType: 0
    text: I don't have time for you, get out of my way!
    playerPortraitSprite: {fileID: 21300000, guid: 5aaf9e47cd173bd4fb104f1c15c3a829, type: 3}
    bossPortraitSprite: {fileID: 21300000, guid: 776dd1cadf3475c4f9b32c46e69dd4f2, type: 3}
  triggerAfterWaveIndex: 2
  delayBeforeDialogueBegins: 0.5
